# Server
NODE_ENV=development
PORT=4000

# MongoDB (local dev: run `mongod` locally, or point at an Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/halaqat

# JWT secrets — generate with `openssl rand -hex 32`, keep out of version control
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Student private-link session token (separate secret so staff and student
# sessions can never be forged into one another)
STUDENT_JWT_SECRET=replace-with-yet-another-long-random-string
STUDENT_JWT_TTL=90d

# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:5173

# Cookie domain for the httpOnly refresh cookie (leave unset on localhost)
COOKIE_DOMAIN=
